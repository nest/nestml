#
# Physical quantities used as data types are known and well-formed. Positive case.
#
model CoCoQuantitiesValid:
    parameters:
        var_a "voltage" = 10 mV
        var_b "electrical potential" = 10 mV
        var_c "conductance / time" = 1 nS/ms
        var_d "1 / time" = 1 ms**-1
        var_e "(amount of substance)**2" = 1 mol**2
        var_f "time**-(1/2)" = 1 ms**-(1/2)
        var_g "current   *   resistance" = 1 mV
