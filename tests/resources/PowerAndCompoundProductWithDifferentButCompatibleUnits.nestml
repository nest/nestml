model BlockTest:
    state:
        V_squared "voltage**2" = (2 V)**2
        V_root "voltage" = (4 V**2)**0.5
        g "conductance" = (50 MOhm)**-1
        f "frequency" = (0.1 s)**-1
        V_param "voltage" = (2 V)**p
        V_max "voltage" = max(1 V, 2 mV)
        V_pow "voltage" = pow(2 V, 1 ms * 1 Hz)
        V_product "voltage" = 1 mV
        V_quotient "voltage" = 1 mV
        V_volt "voltage" = 1 V
        n_floor real = 1
        V_grid "voltage" = 2.7 mV

    parameters:
        p real = 1

    update:
        V_product *= 2 V / (1 mV)
        V_quotient /= 2 mV / (1 V)
        V_volt *= 1 mA * 1 Ohm * V**-1
        V_volt /= 1 mA * 1 Ohm * V**-1
        n_floor //= 2 mV / (1 V)
        V_grid = (V_grid // 1 mV) * 1 mV
