model BlockTest:
    state:
        V_squared mV**2 = (2 V)**2
        V_root mV = (4 V**2)**0.5
        g nS = (50 MOhm)**-1
        f Hz = (0.1 s)**-1
        V_param mV = (2 V)**p
        V_max mV = max(1 V, 2 mV)
        V_pow V = pow(2 V, 1 ms * 1 Hz)
        V_product mV = 1 mV
        V_quotient mV = 1 mV
        V_volt V = 1 V
        V_floor mV = 1 mV

    parameters:
        p real = 1

    update:
        V_product *= 2 V / (1 mV)
        V_quotient /= 2 mV / (1 V)
        V_volt *= 1 mA * 1 Ohm * V**-1
        V_volt /= 1 mA * 1 Ohm * V**-1
        V_floor //= 2 mV / (1 V)
