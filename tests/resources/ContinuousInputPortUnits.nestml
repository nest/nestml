model ContinuousInputPortUnits:
    state:
        V_m "voltage" = 0 mV

    parameters:
        C_m "capacitance" = 250 pF
        tau_m "time" = 10 ms

    input:
        I_stim pA <- continuous
        I_dimensionless real <- continuous

    equations:
        V_m' = -V_m / tau_m + I_stim / C_m + I_dimensionless * 1 nA / C_m

    update:
        integrate_odes()
