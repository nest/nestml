#
# Integer division (``//``, ``//=``) and the rounding functions (``floor()``, ``ceil()``, ``round()``) are only applied to dimensionless values. Negative case.
#
model CoCoTruncationOperandsDimensionless:
    state:
        V_m "voltage" = -70.3 mV
        n integer = 7

    update:
        V_m = V_m // 2              # error: the quotient is a voltage
        V_m //= 2                   # error: the variable is a voltage
        n //= 2 mV                  # error: the divisor is a voltage
        V_m = floor(V_m)            # error: the argument is a voltage
        V_m = ceil(V_m)             # error: the argument is a voltage
        V_m = round(V_m)            # error: the argument is a voltage
