#
# Physical quantities that are combined using powers (including negative and fractional powers), products and quotients are type-checked correctly. Negative case.
#
model CoCoComplexQuantities:
    state:
        rate_y "1 / time" = 1 ms**-1

    parameters:
        p "(voltage / time)**-(1/2)" = 2 (V/s)**(1/2)            # error: wrong sign of the exponent
        q "time**(1/2)" = (1 mV)**(1/2)                          # error: wrong base dimension
        r "(conductance / capacitance)**(1/2)" = 1 ms**-(1/3)    # error: wrong exponent
        b_sqrt_rate "(conductance / capacitance)**(1/2)" = 4 (nS/uF)**(1/2)

    update:
        rate_y = b_sqrt_rate    # error: "time**-(1/2)" assigned to "1 / time"
