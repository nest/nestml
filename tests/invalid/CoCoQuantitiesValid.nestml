#
# Physical quantities used as data types are known and well-formed. Negative case.
#
model CoCoQuantitiesValid:
    parameters:
        var_a "voltaeg" = 10 mV                 # error: unknown quantity
        var_b "conductance // time" = 1 nS/ms   # error: malformed quantity expression
        var_c "2 / time" = 1 ms**-1             # error: numeric numerator not 1
