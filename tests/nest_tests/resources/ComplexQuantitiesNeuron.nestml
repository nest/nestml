#
# Model with physical quantities that are combined using powers (including negative and fractional powers), products and quotients. See ``tests/nest_tests/test_complex_quantities.py`` and ``tests/python_standalone_tests/test_complex_quantities.py``.
#
model complex_quantities_neuron:
    state:
        rate_y "1 / time" = b_sqrt_rate**2                       # (time**-(1/2))**2 = 1 / time
        t_half "time**(1/2)" = a_2 * (1 mV)**(1/2)               # (time / voltage)**(1/2) * voltage**(1/2)
        s_1 "(voltage / time)**-(1/2)" = a_1
        w real = 1

    equations:
        w' = -w / (a_1**2 * 1 mV)                                # time constant: (time / voltage) * voltage = time (4 ms)

    parameters:
        a_1 "(voltage / time)**-(1/2)" = 2 (V/s)**-(1/2)
        a_2 "(time / voltage)**(1/2)" = 2 (V/ms)**-(1/2)        # same dimension as a_1, written differently
        b_sqrt_rate "(conductance / capacitance)**(1/2)" = 4 (nS/uF)**(1/2)
        c "(current * resistance)**2 / (voltage * time)" = 3 mV/ms

    update:
        integrate_odes()
        s_1 = 3 * a_2
