model time_variable_pre_post_synapse:
  state:
    x "time" = 0 ms
    y "time" = 0 ms
    z "time" = 0 ms

  onReceive(pre_spikes):
    y = t

  onReceive(post_spikes):
    z = t

  parameters:
    w real = 1
    d "time" = 1 ms

  input:
    pre_spikes <- spike
    post_spikes <- spike

  update:
    x = t + timestep()
