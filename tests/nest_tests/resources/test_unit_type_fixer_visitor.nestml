model test_unit_type_fixer_visitor:

    state:
        s0 real = foo / 1 pA * bar
        s1 real = foo / 1 pA / bar
        s2 real = foo * 1 pA * bar
        s3 real = foo * 1 pA / bar

        s4 real = (2 * foo) / 1 pA * (bar * 2)
        s5 real = (2 * foo) / 1 pA / (bar * 2)
        s6 real = (2 * foo) * 1 pA * (bar * 2)
        s7 real = (2 * foo) * 1 pA / (bar * 2)

    parameters:
        foo real = 42
        bar pA = 42 pA
