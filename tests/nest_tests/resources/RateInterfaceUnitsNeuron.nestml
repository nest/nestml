model rate_interface_units_neuron:
    state:
        r "1 / time" = 20 Hz
        r_decaying "1 / time" = 50 Hz
        n real = 0    # the expected number of events, given a rate ``r_param``

    parameters:
        r_param "1 / time" = 5 Hz
        tau "time" = 100 ms

    equations:
        recordable inline r_inline "1 / time" = 2 * r
        r_decaying' = -r_decaying / tau

    update:
        integrate_odes()
        n += r_param * resolution()
