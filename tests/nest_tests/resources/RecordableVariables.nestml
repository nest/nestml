model recordable_variables:
    state:
        V_ex "voltage" = -5 mV
        V_rel "voltage" = 0 mV  # Membrane potential relative to the reset potential

    equations:
        kernel I_kernel = exp(-t / tau_syn)
        inline I_syn "current" = unit_psc * convolve(I_kernel, input_spikes)
        recordable inline V_m "voltage" = V_rel + V_reset
        V_rel' = -V_rel / tau_m + (I_syn + I_e + I_stim) / C_m

    parameters:
        tau_m "time" = 10 ms
        tau_syn "time" = 2 ms
        I_e "current" = 0 pA
        C_m "capacitance" = 250 pF
        V_reset "voltage" = -70 mV
        V_thr "voltage" = -55 mV

    internals:
        unit_psc "current" = 1 pA        # Unitary postsynaptic current amplitude

    input:
        input_spikes <- spike
        I_stim pA <- continuous

    update:
        integrate_odes()
        V_ex = -10 mV

        if V_m >= V_thr:    # Threshold is crossed
            V_rel = 0 mV    # Reset the membrane potential
            emit_spike()

    output:
        spike
