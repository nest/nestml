model iaf_psc_exp_multisynapse_vectors_neuron:
    state:
        V_m "voltage" = E_L           # Membrane potential
        refr_t "time" = 0 ms       # Refractory period timer
        is_refractory boolean = false

    equations:
        kernel I_kernel1 = exp(-t / tau_syn1)
        kernel I_kernel2 = exp(-t / tau_syn2)
        kernel I_kernel3 = -exp(-t / tau_syn3)

        inline I_syn "current" = unit_psc * (convolve(I_kernel1, spikes[0]) + convolve(I_kernel2, spikes[1]) + convolve(I_kernel3, spikes[2]))

        V_m' = -(V_m - E_L) / tau_m + (I_syn + I_e + I_stim) / C_m

    parameters:
        C_m "capacitance" = 250pF         # Capacitance of the membrane
        tau_m "time" = 10ms        # Membrane time constant
        tau_syn1 "time" = .2ms     # Time constant of synaptic current
        tau_syn2 "time" = 2ms      # Time constant of synaptic current
        tau_syn3 "time" = 20ms     # Time constant of synaptic current
        refr_T "time" = 2 ms       # Duration of refractory period
        E_L "voltage" = -70mV         # Resting potential
        V_reset "voltage" = -70.0 mV  # Reset value of the membrane potential
        V_th "voltage" = -55.0 mV     # Threshold
        I_e "current" = 0 pA           # External current

    internals:
        unit_psc "current" = 1 pA     # Unitary postsynaptic current amplitude

    input:
        spikes[3] <- spike
        I_stim pA <- continuous

    output:
        spike

    update:
        if is_refractory:
            # neuron is absolute refractory, do not evolve ODEs
            refr_t -= resolution()
        else:
            # neuron not refractory, so evolve all ODEs (including V_m)
            integrate_odes()

    onCondition(not is_refractory and V_m >= V_th):
        # threshold crossing
        refr_t = refr_T    # start of the refractory period
        is_refractory = true
        V_m = V_reset
        emit_spike()

    onCondition(is_refractory and refr_t <= resolution() / 2):
        # end of refractory period
        refr_t = 0 ms
        is_refractory = false
