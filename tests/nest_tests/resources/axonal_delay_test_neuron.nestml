#
# You should have received a copy of the GNU General Public License
# along with NEST.  If not, see <http://www.gnu.org/licenses/>.
#
#
model axonal_delay_test_neuron:
    state:
        w_received real = 0.        # total weight of the spikes received on port ``plastic_spikes`` in the current timestep
        w_received_lti real = 0.    # total weight of the spikes received on port ``plastic_spikes_lti`` in the current timestep

    input:
        drive_spikes <- spike          # receptor type 1: every spike received on this port is repeated
        plastic_spikes <- spike        # receptor type 2: weights are recorded
        plastic_spikes_lti <- spike    # receptor type 3: weights are recorded

    output:
        spike

    onReceive(drive_spikes):
        emit_spike()

    onReceive(plastic_spikes):
        w_received += get_weight(plastic_spikes, t)

    onReceive(plastic_spikes_lti):
        w_received_lti += get_weight(plastic_spikes_lti, t)

    update:
        # the recorded weights are reset at the start of every timestep
        w_received = 0.
        w_received_lti = 0.
