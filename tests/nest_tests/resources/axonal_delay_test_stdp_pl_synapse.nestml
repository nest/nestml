#
#
model axonal_delay_test_stdp_pl_synapse:
    state:
        w real = 1.             # synaptic weight
        pre_trace real = 0.
        post_trace real = 0.

    parameters:
        lambda real = 0.1       # learning rate
        alpha real = 1.         # relative learning rate for depression
        mu real = 0.4           # weight dependence exponent for facilitation
        tau_plus ms = 20 ms     # time constant of the presynaptic trace
        tau_minus ms = 30 ms    # time constant of the postsynaptic trace

    equations:
        pre_trace' = -pre_trace / tau_plus
        post_trace' = -post_trace / tau_minus

    input:
        pre_spikes <- spike
        post_spikes <- spike

    output:
        spike

    onReceive(post_spikes):
        post_trace += 1

        # facilitation
        w += lambda * w**mu * pre_trace

    onReceive(pre_spikes):
        pre_trace += 1

        # depression
        w = max(0., w - lambda * alpha * w * post_trace)

        emit_spike(w)

    update:
        integrate_odes()
