# aeif_psc_exp - Current based adaptive exponential integrate-and-fire neuron model
# ################################################################################
#
# Description
# +++++++++++
#
# aeif_psc_exp is the adaptive exponential integrate and fire neuron according to Brette and Gerstner (2005), with post-synaptic currents in the form of truncated exponentials.
#
# The membrane potential is given by the following differential equation:
#
# .. math::
#
#    C_m \frac{dV}{dt} = -g_L(V-E_L) + g_L\Delta_T \exp\left(\frac{V-V_{th}}{\Delta_T}\right)
#     + I_{syn\_ex}(t) - I_{syn\_in}(t) - w + I_e
#
# and
#
# .. math::
#
#  \tau_w \frac{dw}{dt} = a(V_m-E_L) - w
#
# Note that the membrane potential can diverge to positive infinity due to the exponential term. To avoid numerical instabilities, instead of :math:`V_m`, the value :math:`\min(V_m,V_{peak})` is used in the dynamical equations.
#
#
# References
# ++++++++++
#
# .. [1] Brette R and Gerstner W (2005). Adaptive exponential
#        integrate-and-fire model as an effective description of neuronal
#        activity. Journal of Neurophysiology. 943637-3642
#        DOI: https://doi.org/10.1152/jn.00686.2005
#
#
# See also
# ++++++++
#
# iaf_psc_exp, aeif_cond_exp

model aeif_psc_exp_neuron:

    state:
        V_m "voltage" = E_L       # Membrane potential
        w "current" = 0 pA        # Spike-adaptation current
        refr_t "time" = 0 ms    # Refractory period timer
        # is_refractory boolean = False
        I_syn_exc "current" = 0 pA
        I_syn_inh "current" = 0 pA

    equations:
        inline V_bounded "voltage" = min(V_m, V_peak) # prevent exponential divergence

        # Add inlines to simplify the equation definition of V_m
        inline exp_arg real = (V_bounded - V_th) / Delta_T
        inline I_spike "current" = g_L * Delta_T * exp(exp_arg)

        I_syn_exc' = -I_syn_exc / tau_exc
        I_syn_inh' = -I_syn_inh / tau_inh
        V_m' = (-g_L * (V_bounded - E_L) + I_spike + I_syn_exc - I_syn_inh - w + I_e + I_stim) / C_m
        w' = (a * (V_bounded - E_L) - w) / tau_w

        refr_t' = -1    # refractoriness is implemented as an ODE, representing a timer counting back down to zero, at a rate of one (milli)second per (milli)second

    parameters:
        # membrane parameters
        C_m "capacitance" = 281.0 pF         # Membrane Capacitance
        refr_T "time" = 2 ms         # Duration of refractory period
        V_reset "voltage" = -60.0 mV     # Reset Potential
        g_L "conductance" = 30.0 nS          # Leak Conductance
        E_L "voltage" = -70.6 mV         # Leak reversal Potential (aka resting potential)

        # spike adaptation parameters
        a "conductance" = 4 nS               # Subthreshold adaptation
        b "current" = 80.5 pA            # Spike-triggered adaptation
        Delta_T "voltage" = 2.0 mV       # Slope factor
        tau_w "time" = 144.0 ms       # Adaptation time constant
        V_th "voltage" = -50.4 mV        # Threshold Potential
        V_peak "voltage" = 0 mV          # Spike detection threshold

        # synaptic parameters
        tau_exc "time" = 0.2 ms    # Synaptic Time Constant Excitatory Synapse
        tau_inh "time" = 2.0 ms    # Synaptic Time Constant for Inhibitory Synapse

        # constant external input current
        I_e "current" = 0 pA

    internals:
        unit_psc "current" = 1 pA        # Unitary postsynaptic current amplitude

    input:
        exc_spikes <- spike
        inh_spikes <- spike
        I_stim pA <- continuous

    output:
        spike

    update:
        if refr_t > 0 ms:
            # neuron is absolute refractory, do not evolve V_m
            integrate_odes(I_syn_exc, I_syn_inh, w, refr_t)
        else:
            # neuron not refractory
            integrate_odes(I_syn_exc, I_syn_inh, w, V_m)

    onReceive(exc_spikes):
        I_syn_exc += unit_psc * get_weight(exc_spikes, t)

    onReceive(inh_spikes):
        I_syn_inh += unit_psc * get_weight(inh_spikes, t)

    onCondition(V_m >= V_th):
        # threshold crossing
        refr_t = refr_T    # start of the refractory period
        V_m = V_reset
        w += b
        emit_spike()
