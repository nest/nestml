  /**
   * Framework for STDP with predominantly axonal delays: the state of the synapse before it processed a presynaptic spike, which is needed to retrospectively correct the synapse and the transmitted weight in case a postsynaptic spike occurs that should have been processed before the presynaptic spike.
  **/
  struct AxDelaySnapshot_
  {
    double t_spike;        //!< time of the presynaptic spike [ms]
    double t_lastspike;    //!< value of ``t_lastspike_`` before the presynaptic spike was processed [ms]
    State_ S;              //!< state of the synapse before the presynaptic spike was processed
    size_t multiplicity;   //!< multiplicity of the presynaptic spike event
    bool spike_emitted;    //!< whether a spike was transmitted to the postsynaptic neuron
    double weight;         //!< the weight that was transmitted to the postsynaptic neuron (after the most recent correction)

    AxDelaySnapshot_( const double t_spike, const double t_lastspike, const State_& S, const size_t multiplicity )
      : t_spike( t_spike )
      , t_lastspike( t_lastspike )
      , S( S )
      , multiplicity( multiplicity )
      , spike_emitted( false )
      , weight( 0. )
    {
    }
  };

  /**
   * Snapshots for the presynaptic spikes that can still require a correction, ordered by spike time.
  **/
  std::vector< AxDelaySnapshot_ > ax_delay_snapshots_;

  /**
   * Remove the snapshots of presynaptic spikes that can no longer require a correction, because the time interval during which a postsynaptic spike could reach the synapse before the presynaptic spike ended before time ``t``.
   *
   * While a presynaptic spike can still be corrected, the postsynaptic spike history that was read when processing the spike is still needed to replay its processing. The history entries are therefore only marked as read by this synapse (allowing the postsynaptic neuron to remove them from its history) once the snapshot is removed.
  **/
  void prune_ax_delay_snapshots_( const double t, {{ paired_neuron_name }}* __target );
