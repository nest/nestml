/**
 * Framework for STDP with predominantly axonal delays
**/
template < typename targetidentifierT >
void
{{synapseName}}< targetidentifierT >::prune_ax_delay_snapshots_( const double t, {{ paired_neuron_name }}* __target )
{
  const double eps = kernel().connection_manager.get_stdp_eps();
  const double __post_delay = get_dendritic_delay_() - get_axonal_delay_();    // see send(); a presynaptic spike at t_pre can be corrected by postsynaptic spikes up to time t_pre - __post_delay

  auto it = ax_delay_snapshots_.begin();
  while ( it != ax_delay_snapshots_.end() and it->t_spike - __post_delay < t - eps )
  {
    // mark the postsynaptic spikes that were (or would have been) read when processing the presynaptic spike as read
    std::deque< histentry__{{ paired_neuron_name }} >::iterator start;
    std::deque< histentry__{{ paired_neuron_name }} >::iterator finish;
    __target->get_history__( it->t_lastspike - __post_delay, it->t_spike - __post_delay, &start, &finish, true );

    ++it;
  }
  ax_delay_snapshots_.erase( ax_delay_snapshots_.begin(), it );
}

template < typename targetidentifierT >
void
{{synapseName}}< targetidentifierT >::correct_weight_stdp_ax_delay( const size_t tid,
  CorrectionEntrySTDPAxDelay& entry,
  const double t_spike_critical_interval_end,
  const double t_post_spike,
  const CommonPropertiesType& cp )
{
  const double eps = kernel().connection_manager.get_stdp_eps();
  const double __post_delay = get_dendritic_delay_() - get_axonal_delay_();    // see send()

  // time of the presynaptic spike that needs to be corrected
  const double t_spike = t_spike_critical_interval_end + __post_delay;

#ifdef DEBUG
  std::cout << "[synapse " << this << "] {{ synapseName }}::correct_weight_stdp_ax_delay(): correcting pre spike at t = " << t_spike << " for post spike at t = " << t_post_spike << std::endl;
#endif

  auto it = ax_delay_snapshots_.begin();
  while ( it != ax_delay_snapshots_.end() and std::fabs( it->t_spike - t_spike ) > eps )
  {
    ++it;
  }

  if ( it == ax_delay_snapshots_.end() )
  {
    throw KernelException( "{{ synapseName }}: no stored state found for the presynaptic spike at t = " + std::to_string( t_spike ) + " ms that requires a correction." );
  }

  {{ paired_neuron_name }}* __target = static_cast< {{ paired_neuron_name }}* >( get_target( tid ) );
  assert( __target );

  // N.B. the history entries that are read during the replay (including the new postsynaptic spike) are marked as read only once the presynaptic spike can no longer be corrected (see prune_ax_delay_snapshots_())

  // revert the synapse to its state before the presynaptic spike was processed
  S_ = it->S;
  t_lastspike_ = it->t_lastspike;

  // replay the processing of the presynaptic spike; this time, the new postsynaptic spike is taken into account
  SpikeEvent __e;
  __e.set_stamp( Time::ms_stamp( it->t_spike ) );
  __e.set_multiplicity( it->multiplicity );
  const bool __spike_emitted = send( __e, tid, cp, true );
  const double __new_weight = __spike_emitted ? __e.get_weight() : 0.;

  if ( it->spike_emitted )
  {
    // correct the spike that was already transmitted to the postsynaptic neuron
    WeightCorrectionEvent __ce;
    __ce.set_receiver( *__target );
    __ce.set_weight( it->weight );
    __ce.set_new_weight( __new_weight );
    __ce.set_delay_steps( get_delay_steps() );
    __ce.set_rport( get_rport() );
    __ce.set_stamp( Time::ms_stamp( it->t_spike ) );
    __ce.set_multiplicity( it->multiplicity );
    __ce();

    it->weight = __new_weight;
  }
  // N.B. if no spike was transmitted originally, but the replay emits a spike, this spike cannot be delivered retrospectively

  entry.set_new_weight( it->weight );

  // The corrected state is the starting point for processing the next presynaptic spike of this synapse. If there is one, it can still be corrected as well, and the kernel will request this correction subsequently (in the order of the spike times), as it is caused by the same postsynaptic spike.
  ++it;
  if ( it != ax_delay_snapshots_.end() )
  {
    it->S = S_;
    it->t_lastspike = t_lastspike_;
  }
}
